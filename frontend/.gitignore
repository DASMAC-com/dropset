# cspell:word vercel
/node_modules
/.pnp
.pnp.*

/coverage

/.next/
/out/

/build

/lib/data/icon-manifest.gen.json
/lib/data/wallet-manifest.gen.json

# public/ is generated in full by the predev / prebuild hooks — nothing under
# it is committed. Brand assets are copied from the repo-root brand-assets/
# (../brand-assets/copy-brand-assets.mjs), the flags are mirrored out of
# node_modules (scripts/copy-flags.mjs), and the token / wallet icons are
# fetched (scripts/fetch-token-icons.mjs, scripts/fetch-wallet-icons.mjs).
# Ignoring the directory keeps that invariant self-maintaining: a new brand
# asset needs no edit here, and a file committed into public/ by hand is
# caught. A shared asset belongs in brand-assets/, an app-specific one in a
# script that generates it.
/public/

.DS_Store
*.pem

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

.env*
!.env.example

.vercel

*.tsbuildinfo
next-env.d.ts
