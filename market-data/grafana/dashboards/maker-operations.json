    {
      "datasource": {
        "type": "postgres",
        "uid": "dropset-postgres"
      },
      "description": "What each tick decided, including the outcomes that end the tick early. `Quote` is normal; `Reshape` and `FreezeSide` are the graduated de-risking steps; `Halt` is a kill switch; `Pause` means no usable reference; `Frozen` means the vault is frozen on-chain; `TickError` means the tick failed before deciding anything (see the errors table below); `Unknown` should never appear and means a code path reached no outcome. Note that `TickError` and a decision are not exclusive \u2014 a tick that decided `Halt` and then failed to send it shows `Halt` here, with the failure in the errors table, so count failures by `tick_error IS NOT NULL` rather than by this band. Every one of these is written by the bot on its way out of the tick, so a gap here is an absent bot rather than an idle one.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "options": {
                "FreezeSide": {
                  "color": "orange",
                  "index": 2
                },
                "Frozen": {
                  "color": "dark-red",
                  "index": 5
                },
                "Halt": {
                  "color": "red",
                  "index": 3
                },
                "Pause": {
                  "color": "red",
                  "index": 4
                },
                "Quote": {
                  "color": "green",
                  "index": 0
                },
                "Reshape": {
                  "color": "yellow",
                  "index": 1
                },
                "TickError": {
