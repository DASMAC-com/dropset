      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "dropset-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  to_timestamp(ts) AS \"time\",\n  fair AS \"fair value\",\n  on_chain_reference AS \"reference (on-chain)\",\n  reference AS \"reference (candidate)\",\n  best_bid AS \"best bid\",\n  best_ask AS \"best ask\"\nFROM maker_telemetry\nWHERE $__unixEpochFilter(ts)\n  AND market = ${market:sqlstring}\nORDER BY ts",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "dropset-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH market AS (\n  SELECT\n    market_pubkey,\n    power(10::numeric, base_decimals - quote_decimals) AS price_scale\n  FROM maker_telemetry\n  WHERE market = ${market:sqlstring}\n  ORDER BY ts DESC\n  LIMIT 1\n)\nSELECT\n  to_timestamp(t.block_time) AS \"time\",\n  (t.avg_price * m.price_scale)::double precision AS \"fill\"\nFROM takes t\nJOIN market m ON t.market = m.market_pubkey\nWHERE $__unixEpochFilter(t.block_time)\nORDER BY t.block_time",
          "refId": "B"
        }
      ],
      "title": "Quotes vs fair value \u2014 $market",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "dropset-postgres"
      },
      "description": "Seconds since the newest telemetry sample across ALL markets \u2014 the bot's heartbeat. Not filtered by market on purpose: any market's sample proves the process is alive, so filtering would read one market's halt as a dead bot. Rising without bound means the maker is gone OR its database writes are failing; the two are indistinguishable from here, and `Feed health` plus the container logs are what separate them. Empty (`No data`) means no sample has ever been written.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
