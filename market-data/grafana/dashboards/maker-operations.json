          "rawQuery": true,
          "rawSql": "SELECT\n  market,\n  leg,\n  consensus_state,\n  contributor_count,\n  dispersion_outlier,\n  round(age_secs::numeric, 1) AS age_secs,\n  fresh,\n  to_timestamp(ts) AS observed\nFROM (\n  SELECT DISTINCT ON (market, leg) *\n  FROM maker_legs\n  WHERE ts > extract(epoch FROM now()) - 3600\n  ORDER BY market, leg, ts DESC\n) latest\nORDER BY market, leg",
